PORT=8787
# mock = built-in demo data, local = a real backend that saves its data in server/data/local, live = forward to teammates' services
DATA_MODE=mock
BACKEND_URL=http://localhost:8000
AI_URL=http://localhost:8001

# Only used when DATA_MODE=local.
# Folder for saved data and uploaded reports (default server/data/local). Back this folder up.
LOCAL_DATA_DIR=
# The 6-digit sign-in code everyone uses (no text messages are sent). Set your own before real use.
AUTH_CODE=
# Hospital front-desk phone numbers as phone:hospital, comma separated. Hospital ids: hosp_karve and the others in server/mock/data/hospitals.json.
STAFF_PHONES=9000000001:karve

# Groq (the report chatbot). Leave GROQ_API_KEY empty and the chatbot still answers from the uploaded report using the built-in reader.
# With a key and a model set, answers are written by Groq from the report passages found in the local vector index (server/data/local/vectors.json).
# Get a key at https://console.groq.com. Run npm run check:keys: it lists the models your key can use. openai/gpt-oss-120b and openai/gpt-oss-20b are good choices.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=15000

# Sarvam AI (voice and language only). Leave the key empty to run without it:
# in mock mode the mic returns canned demo transcripts, listen and translate are hidden or pass through.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Run npm run check:keys to test these against your key. Model IDs change over time. Confirm them at https://docs.sarvam.ai before use.
# Suggestions from the project brief: saaras:v3 (speech to text), bulbul:v3 or bulbul:v4-flash (text to speech).
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TRANSLATE_MODEL=

# Voice names for text to speech. If empty, Sarvam's default voice is used.
SARVAM_TTS_SPEAKER_EN=simran_en_customer
SARVAM_TTS_SPEAKER_HI=priya
SARVAM_TTS_SPEAKER_MR=roopa

SARVAM_TIMEOUT_MS=8000
SARVAM_RATE_LIMIT_PER_MINUTE=30
